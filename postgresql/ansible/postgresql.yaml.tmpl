---
- name: Configure Postgresql server
  hosts: all
  become: true
  roles:
    - role: backend-nat
      gateway_ip: [[ .ProcessingVars.gateway_ip ]]
      [[ with .ProcessingVars.dns_servers ]]dns_servers: [[ . ]] [[ end ]]
    - ssh-config
    - role: postgresql
      [[ with .ProcessingVars.pg_user_password ]]pg_user_password: "[[ . ]]" [[ end ]]
      [[- with .ProcessingVars.pg_version ]]pg_version: "[[ . ]]" [[ end ]]
      [[- with .ProcessingVars.pg_port ]]pg_port: [[ . ]] [[ end ]]
    - role: ufw
      [[- with .ProcessingVars.ssh_allowed_ip ]]ssh_allowed_ip: "[[ . ]]" [[ end ]]
      ufw_rules:
      [[- range .ProcessingVars.server_info ]]
        [[- range .private_net_info ]]
        - port: [[ or $.ProcessingVars.pg_port 5432 ]]
          proto: "tcp"
          from_ip: [[ .ip_range ]]
        [[- end ]]
      [[- end ]]

