[postgresql]
[[- range $key, $value := .ProcessingVars.server_info ]]
[[- $first := true ]]
[[ (index $value.private_net_info 0).ip_address ]] provider='[[ $value.provider ]]'
[[- end ]]

[postgresql:vars]
ansible_ssh_private_key_file=[[ .ProcessingVars.ansible_ssh_private_key ]]
ansible_user=[[ .ProcessingVars.ansible_user ]]
ansible_ssh_common_args='-vvv -o StrictHostKeyChecking=[[ or .ProcessingVars.absible_host_key_checking "no" ]] -o UserKnownHostsFile=/dev/null [[ with .ProcessingVars.bastion_address ]] -o ProxyCommand="ssh  -W %h:%p -q ansible@[[ . ]]"[[ end]]'

