[nat-gateway]
[[- range $key, $value := .ProcessingVars.nat_gw_info ]]
[[- $first := true ]]
[[ $value.public_ip_v4 ]] ip_ranges='[ [[- range $value.private_net_info ]] [[- if $first ]] [[- $first = false ]] [[- else ]],[[- end ]]"[[ .ip_range ]]" [[- end  -]] ]' provider='[[ $value.provider ]]'
[[- end ]]

[nat-gateway:vars]
ansible_ssh_private_key_file=[[ .ProcessingVars.ansible_ssh_private_key ]]
ansible_ssh_common_args='-o StrictHostKeyChecking=[[ .ProcessingVars.absible_host_key_checking ]] -o UserKnownHostsFile=/dev/null'
ansible_user=[[ .ProcessingVars.ansible_user ]]