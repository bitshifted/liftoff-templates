
locals {
    hcloud_srv_info = [[ if .Terraform.HasProvider "hcloud" -]] module.hcloud_compute.server_info [[- else -]] {} [[- end ]]
    docean_srv_info = [[ if .Terraform.HasProvider "digitalocean" -]] module.docean_compute.server_info [[- else -]] {} [[- end ]]
}

output "server_info" {
    value = merge(local.hcloud_srv_info, local.docean_srv_info)
}
