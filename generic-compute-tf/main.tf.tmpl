[[- if  .ProcessingVars.use_docean_dns ]]
module "docean_dns" {
    source = "github.com/bitshifted/liftoff-tf-modules//digitalocean-dns?ref=v1.5.0"
    do_dns_records = [for key,srvi in local.all_srv_info: {
        zone = srvi.dns_zone
        type = "A"
        name = key
        value = srvi.public_ip_v4
    } ]
}
[[- end ]]
    
[[- end ]]

